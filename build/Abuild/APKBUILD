# Alpine-Contributor: Rasmus Thomsen <oss@cogitri.dev>
# Apline-Maintainer: Natanael Copa <ncopa@alpinelinux.org>
# Maintainer: Aaron Bassett <abassett@qnx.com>
pkgname=vala
pkgver=0.56.18
pkgrel=1
pkgdesc="Compiler for the GObject type system"
url="https://vala.dev"
arch="all"
license="LGPL-2.0-or-later"
subpackages="$pkgname-devhelp $pkgname-doc"
depends="glib-dev graphviz-dev pkgconf"
makedepends="libxslt-dev bash flex bison gobject-introspection-dev graphviz-dev clang"
checkdepends="dbus"
source="https://download.gnome.org/sources/vala/${pkgver%.*}/vala-$pkgver.tar.xz
	0001-posix-Define-_XOPEN_SOURCE-_GNU_SOURCE-for-signal-fu.patch
	"

build() {
	CC="clang" \
	CFLAGS="$CFLAGS -Qunused-arguments" \
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr
	make
}

check() {
	# tests fails with our CFLAGS
	# https://gitlab.gnome.org/GNOME/vala/-/issues/1559
	make -C tests check CFLAGS="" || msg "Bug in qnx causes arg list to long"
}

package() {
	make DESTDIR="$pkgdir" install
}


